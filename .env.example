# Copy to .env and edit (start.py does this for you). Placeholders only - never commit real secrets.
# Keep comments on their own lines: text after a value on the same line becomes part of the value.

# development | demo | production
APP_ENV=development
SECRET_KEY=replace-with-64-random-hex-characters
# Public address used for absolute links, e.g. https://jansetu.example.gov.in (leave empty to use the request host)
PUBLIC_BASE_URL=
# SQLite path is relative to backend/. For PostgreSQL: postgresql+psycopg://jansetu:CHANGE_ME@db:5432/jansetu
DATABASE_URL=sqlite:///./data/jansetu.db
TOKEN_TTL_MINUTES=60
# Comma-separated list of allowed browser origins; empty = same-origin only
CORS_ORIGINS=
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# First start: create tables and load demo data when the database is empty (never seeds when APP_ENV=production)
AUTO_INIT_DB=true
AUTO_SEED_DEMO=true

# Maps: OpenStreetMap tiles by default. For production use a government or licensed tile server.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
FIELD_LOCATION_TTL_MINUTES=15

# Optional AI provider (OpenAI-compatible chat completions). Empty = transparent rule-based demo classifier.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
TRIAGE_CONFIDENCE_THRESHOLD=0.55

# Optional speech / translation / OCR adapters (require approved credentials)
STT_PROVIDER=
TRANSLATION_PROVIDER=
OCR_PROVIDER=

# Messaging. OTP_PROVIDER=demo shows the code on screen (refused when APP_ENV=production).
OTP_PROVIDER=demo
SMS_PROVIDER=
WHATSAPP_PROVIDER=

ENABLE_BACKGROUND_JOBS=true
ESCALATION_INTERVAL_SECONDS=60
MONITORING_INTERVAL_SECONDS=60
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=30
TRANSCRIPT_RETENTION_DAYS=90
